# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...

# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Куда публиковать дайджест автоматически: @username канала или числовой id (-100...).
# Бот должен быть администратором канала. Оставьте пустым, если нужны только подписчики в личке.
TELEGRAM_CHANNEL_ID=

# Как часто собирать и публиковать новости (часы). 0 — отключить автопубликацию.
DIGEST_INTERVAL_HOURS=6

# Сколько новостей максимум в одном выпуске
MAX_ITEMS_PER_DIGEST=5

# Насколько свежие новости брать (часы)
MAX_ARTICLE_AGE_HOURS=36

# Модель Claude
CLAUDE_MODEL=claude-opus-5-5

# Путь к базе данных
DB_PATH=data/newsbot.sqlite3

# Telegram id администраторов через запятую (им доступна команда /run)
ADMIN_IDS=
