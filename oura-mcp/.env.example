# ---- Вариант A: готовый токен (Personal Access Token или access_token из OAuth) ----
# Если задан, сервер использует его напрямую. Если вместе с ним заданы
# OURA_REFRESH_TOKEN + OURA_CLIENT_ID + OURA_CLIENT_SECRET, токен будет обновляться сам.
OURA_ACCESS_TOKEN=

# ---- Вариант B: OAuth2-приложение (https://cloud.ouraring.com/oauth/applications) ----
# Затем один раз: npm run auth  -> токены сохранятся в ~/.oura-mcp/tokens.json
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Redirect URI должен совпадать с тем, что указан в настройках приложения Oura
OURA_REDIRECT_URI=http://localhost:8484/callback
# Scopes через пробел (email personal daily heartrate workout tag session spo2)
OURA_SCOPES=personal daily heartrate workout session tag spo2
# Куда сохранять токены OAuth
OURA_TOKEN_PATH=~/.oura-mcp/tokens.json

# ---- Необязательно ----
# Часовой пояс для "сегодня" при расчёте дат по умолчанию (IANA, напр. Europe/Moscow)
OURA_TIMEZONE=
